# Shopify App credentials — get these from dev.shopify.com
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# OAuth scopes required by the app
SCOPES=read_products

# Public HTTPS URL (ngrok / localtunnel in dev, your server domain in production)
HOST=https://your-tunnel-or-domain.com

# Server port
PORT=3000

# SQLite database file path (relative to project root)
SQLITE_PATH=./database.sqlite

# development | production
NODE_ENV=development

# Optional: override exchange rate API (default: open.er-api.com)
# EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest

# Optional: override geolocation API (default: ip-api.com)
# GEO_API_URL=http://ip-api.com/json
